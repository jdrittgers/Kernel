# Farm Bidding Platform - Environment Variables
# Copy this file to .env and fill in your values

# Base Environment
NODE_ENV="development"

# Session Secrets (REQUIRED)
# Generate random secrets using: openssl rand -base64 32
# Or use https://randomkeygen.com/
SESSION_SECRET="change-this-to-a-random-secret-key"
ENCRYPTION_SECRET="change-this-to-another-random-secret-key"

# Base URLs
DEV_HOST_URL="http://localhost:3000"
PROD_HOST_URL=""  # Set this when deploying (e.g., https://your-app.vercel.app)

# Database
# For local development (SQLite):
DATABASE_URL="file:./data.db?connection_limit=1"

# For production (PostgreSQL) - Replace with your database URL:
# DATABASE_URL="postgresql://user:password@host:5432/database"
# Examples:
# - Railway: postgresql://postgres:xxx@containers-us-west-1.railway.app:5432/railway
# - Supabase: postgresql://postgres:xxx@db.xxx.supabase.co:5432/postgres
# - Neon: postgresql://user:xxx@ep-xxx.us-east-2.aws.neon.tech/neondb

# Optional: Email Provider (for password reset features - not required for basic functionality)
EMAIL_PROVIDER_API_KEY=